  "texts": {
    "fr": {
      "dinner": {
        "intro": "Tajine, couscous ou pastilla préparés à la maison le jour même, avec des produits frais, et servis dans le patio à la lueur des bougies.",
        "li2": null,
        "li3": "À commander la veille ou au plus tard avant 12h le jour même.",
        "service": "Service de {from} à {to} dans le patio."
      },
      "transfer": {
        "detailed": true,
        "intro": "Un chauffeur vous attend à l'aéroport ou à la gare et vous accompagne jusqu'au point d'accès au riad. Tarif fixe, sans négociation et sans mauvaise surprise.",
        "li1": "Notre chauffeur vous attend avec un panneau au nom de RIAD BILKIS.",
        "li2": "En cas de retard de votre vol, l'attente est incluse.",
        "li3": "Véhicule privé et climatisé.",
        "li4": "Tarif fixe par véhicule."
      }
    },
    "en": {
      "dinner": {
        "intro": "Tagine, couscous or pastilla home-cooked the same day with fresh produce, served in the patio by candlelight.",
        "li2": null,
        "li3": "To be ordered the day before or by 12 pm on the day at the latest.",
        "service": "Served from {from} to {to} in the patio."
      },
      "transfer": {
        "detailed": true,
        "intro": "A driver waits for you at the airport or the train station and walks you to the riad's access point. Fixed price, no haggling, no surprises.",
        "li1": "Our driver waits for you holding a sign reading RIAD BILKIS.",
        "li2": "If your flight is delayed, waiting time is included.",
        "li3": "Private air-conditioned vehicle.",
        "li4": "Fixed price per vehicle."
      }
    },
    "es": {
      "dinner": {
        "intro": "Tajín, cuscús o pastela preparados en casa el mismo día con productos frescos, y servidos en el patio a la luz de las velas.",
        "li2": null,
        "li3": "Se pide la víspera o, como muy tarde, antes de las 12h del mismo día.",
        "service": "Servicio de {from} a {to} en el patio."
      },
      "transfer": {
        "detailed": true,
        "intro": "Un conductor le espera en el aeropuerto o en la estación y le acompaña hasta el punto de acceso al riad. Precio fijo, sin negociar y sin sorpresas.",
        "li1": "Nuestro conductor le espera con un cartel con el nombre RIAD BILKIS.",
        "li2": "Si su vuelo se retrasa, la espera está incluida.",
        "li3": "Vehículo privado con aire acondicionado.",
        "li4": "Precio fijo por vehículo."
      }
    }
  }
