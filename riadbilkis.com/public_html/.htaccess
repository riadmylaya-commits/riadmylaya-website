# BEGIN Riad Bilkis — pages statiques et SEO
# Ce bloc doit rester AVANT le bloc WordPress : les URL propres des pages
# activités doivent être servies avant que WordPress ne réponde 404.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer le domaine canonique en HTTPS sans www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.riadbilkis\.com$ [NC]
  RewriteRule ^(.*)$ https://riadbilkis.com/$1 [R=301,L]

  # Pages activités GetYourGuide (URL propres, contenu statique)
  RewriteRule ^activites-groupe/?$ /gyg/fr.html [L]
  RewriteRule ^en/group-activities/?$ /gyg/en.html [L]
  RewriteRule ^es/actividades/?$ /gyg/es.html [L]

  # Anciennes URL éventuelles vers les pages activités
  RewriteRule ^activites/?$ /activites-groupe [R=301,L]
  RewriteRule ^en/activities/?$ /en/group-activities [R=301,L]
  RewriteRule ^es/actividades-en-grupo/?$ /es/actividades [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=(), usb=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
# END Riad Bilkis — pages statiques et SEO

# BEGIN WordPress
# Les directives (lignes) entre « BEGIN WordPress » et « END WordPress » sont générées
# dynamiquement, et doivent être modifiées uniquement via les filtres WordPress.
# Toute modification des directives situées entre ces marqueurs sera surchargée.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# BEGIN Really Simple Security Disable directory indexing
# Disable directory indexing to prevent listing of directory contents
Options -Indexes
# END Really Simple Security Disable directory indexing
